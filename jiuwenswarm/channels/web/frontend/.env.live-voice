# Explicit controlled Formal Live Voice build profile. These are non-secret,
# build-time switches; provider credentials and runtime authorization stay out
# of the repository.
VITE_FEATURE_LIVE_VOICE_INTEGRATED_WEB=true
VITE_FEATURE_LIVE_VOICE_INTEGRATED_P1=true
VITE_FEATURE_LIVE_VOICE_PRODUCT_P3_MUTATION=true
