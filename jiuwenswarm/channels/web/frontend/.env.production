# The hx/0812_live_voice_w3 production bundle is the integrated Live Voice demo.
# These are non-secret, build-time feature switches. Machine-private provider
# credentials and runtime authorization remain outside the repository.
VITE_FEATURE_LIVE_VOICE_INTEGRATED_WEB=true
VITE_FEATURE_LIVE_VOICE_INTEGRATED_P1=true
VITE_FEATURE_LIVE_VOICE_PRODUCT_P3_MUTATION=true
