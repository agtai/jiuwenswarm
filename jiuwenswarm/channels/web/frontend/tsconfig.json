{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      /* Bundled application plugins live outside this project root
         (extensions/<name>/frontend) and are compiled into this build. Their
         directories have no node_modules of their own, so a bare specifier
         resolved from there finds nothing; map every one back to the app's
         own dependencies, which is the single copy Vite bundles anyway. */
      "*": ["node_modules/@types/*", "node_modules/*"]
    }
  },
  "include": ["src", "tests/fixtures/settings-extension"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
