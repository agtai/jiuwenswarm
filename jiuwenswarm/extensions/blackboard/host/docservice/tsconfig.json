{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../../../../channels/web/frontend/node_modules/@types"],
    "paths": {
      "*": ["../../../../channels/web/frontend/node_modules/*", "../../../../channels/web/frontend/node_modules/@types/*"]
    }
  },
  "include": ["src", "test", "vendor/*.d.ts"]
}
