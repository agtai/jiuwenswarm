+    f.deep.set_react_agent(f.agent, initialized=True)
+    f.deep.ability_manager = f.agent.ability_manager
+    await f.deep.start(session=f.session)
+    f.chunks = []
+
+    async def collect():
+        async for chunk in f.stream:
+            f.chunks.append(chunk)
+    f.collect = collect
